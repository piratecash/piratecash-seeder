# Local PirateCash Core JSON-RPC. Set your own credentials before deployment.
RPC_URL=http://127.0.0.1:19606/
RPC_USER=user
RPC_PASSWORD=change-me
RPC_POLL_INTERVAL=300
RPC_TIMEOUT=10

# Comma/space-separated literal IPv4/IPv6 addresses, optionally with P2P ports.
# Used before a successful poll, or when a successful poll has no active nodes.
# Replace these documentation IPs with your own known bootstrap nodes.
BOOTSTRAP_NODES=192.0.2.10,192.0.2.11,[2001:db8::10]:63636

DNS_HOST=dnsseed.example.com
DNS_NS=ns.example.com
# SOA mailbox with @ replaced by a dot. Defaults to hostmaster.<DNS_HOST>.
DNS_MBOX=hostmaster.example.com
DNS_PORT=5353
DNS_THREADS=4
DNS_TTL=300
DNS_NS_TTL=40000
